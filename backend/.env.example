# Supabase — obtener desde: https://supabase.com/dashboard > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-public-key>

# JWT Secret — obtener desde: Supabase > Project Settings > API > JWT Settings > JWT Secret
# IMPORTANTE: este valor NO es el mismo que SUPABASE_KEY
SUPABASE_JWT_SECRET=<jwt-secret>

# Clave secreta propia para tokens internos
# Generar con: openssl rand -base64 64
SECRET_KEY=<secret-key>

# Cadena de conexión a PostgreSQL (Supabase)
# Usar el Transaction Pooler para entornos serverless/Render
# Obtener desde: Supabase > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
